    "test:smoke": "node tests/smoke.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1"
  },
  "dependencies": {
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.1",
    "puppeteer-core": "^23.11.1"
  },
  "type": "module"
}
